# Public origin of the site, no trailing slash. Must match the Meta app settings exactly.
APP_URL=https://app.example.com

# Meta app (Instagram API with Instagram Login). Use the Instagram app ID/secret
# shown under Instagram > API setup, not the Facebook app ID.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v26.0

# Postgres connection string (Neon, Supabase, or Koyeb Postgres).
DATABASE_URL=

# Generate each with: openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=
CRON_SECRET=

# Cloudflare R2 (S3-compatible) media storage. Instagram must fetch media from a public HTTPS URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://media.example.com

